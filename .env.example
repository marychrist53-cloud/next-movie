TMDB_TOKEN=your_tmdb_read_access_token
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 on Vercel (and any host that overwrites X-Forwarded-For).
# TRUST_PROXY_HEADERS=1

# Server-only chat model. Never prefix these with NEXT_PUBLIC_.
# OpenAI-compatible keys start with sk- and use this endpoint:
AI_API_KEY=your_openai_or_compatible_key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Google AI Studio / Gemini key. Prefer GEMINI_API_KEY; a non-sk AI_API_KEY
# is also treated as Gemini.
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash

# A long random value used to authenticate /api/cron/notifications.
CRON_SECRET=replace_with_a_long_random_secret

# The owner is provisioned from these values; public registration never grants roles.
OWNER_NAME=Site Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace_with_a_strong_unique_password

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_public_vapid_key
VAPID_PRIVATE_KEY=your_private_vapid_key
VAPID_SUBJECT=mailto:owner@example.com

# Local SQLite file. Ignored on Vercel — use Turso there instead.
DATABASE_PATH=./data/nextmovie.db

# Required on Vercel. Hosted SQLite; local node:sqlite cannot persist on serverless.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Optional local seed settings.
SEED_TEST_PASSWORD=TestUser123!
# ALLOW_TEST_SEED=1
